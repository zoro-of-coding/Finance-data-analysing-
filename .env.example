# Bright Data Scraper Studio — credentials
# API key: https://brightdata.com/cp/setting/users  (Account Settings -> API tokens)
BRIGHTDATA_API_KEY=

# Yahoo Finance collector built with Scraper Studio (created by `npm run create-collector`)
COLLECTOR_ID=

# ---- Scrape inputs ----------------------------------------------------------
# Comma-separated Yahoo Finance quote URLs (or symbols) to scrape each cycle.
# When symbols are given they are expanded to https://finance.yahoo.com/quote/<SYM>
SCRAPE_URLS=https://finance.yahoo.com/quote/AAPL,https://finance.yahoo.com/quote/MSFT,https://finance.yahoo.com/quote/NVDA
# Alternatively list symbols only and the pipeline builds the URLs:
SCRAPE_SYMBOLS=AAPL,MSFT,NVDA

# ---- Self-healing -----------------------------------------------------------
# Heal automatically when validation fails. Set to false to only alert + log.
AUTO_HEAL=true
# Auto-approve the AI's proposed fix without waiting for a human.
AUTO_APPROVE=true
# Stop healing attempts after this many consecutive failures in a row.
MAX_HEAL_ATTEMPTS=2

# ---- Validation tuning ------------------------------------------------------
# Fields that MUST be present and non-empty in every row.
REQUIRED_FIELDS=symbol,regularMarketPrice
# A row is only useful if at least this fraction of expected fields is non-empty.
MIN_FIELD_FILL_RATE=0.7
# Alert (and heal) if this many consecutive rows are unusable.
MAX_BAD_ROWS=0

# ---- Monitoring / alerting --------------------------------------------------
# Generic webhook (Slack/Discord/Make/Zapier style). Leave empty to disable.
ALERT_WEBHOOK_URL=
# Health badge: path where latest status.json is written (used by dashboard).
STATUS_FILE=./data/status.json

# ---- Scheduler (daemon) -----------------------------------------------------
# Cycle interval in seconds for `npm run daemon`.
DAEMON_INTERVAL_SECONDS=3600

# ---- Dashboard --------------------------------------------------------------
DASHBOARD_PORT=4173
# Host the dashboard binds to. "0.0.0.0" exposes it on your LAN so phones/tablets
# on the same Wi-Fi can open http://<PC-LAN-IP>:<DASHBOARD_PORT>.
DASHBOARD_HOST=0.0.0.0

# ---- Local AI analyst (Llama 3.2-1B) ---------------------------------------
# Path to the Hugging Face model folder (safetensors + tokenizer).
LLM_MODEL_DIR=./llama3.2-1b
# Python interpreter that has torch + transformers installed (see `npm run setup-llm`).
PYTHON=python
